   137	// Insert a 0 bit at position `pos`: bits below stay, bits >=pos shift up by one.
   138	static inline u64 insert_zero_bit(u64 val, u32 pos) {
   139	    u64 lo = val & ((1ull << pos) - 1ull);
   140	    u64 hi = (val & ~((1ull << pos) - 1ull)) << 1;
   141	    return lo | hi;
   142	}
   143	
   144	// Scatter i over one zeroed bit slot at `pos` — mirrors SVM scatter_bits_1.
   145	static inline u64 scatter_bits_1(u64 val, u32 pos) { return insert_zero_bit(val, pos); }
   146	
   147	// Scatter i over two zeroed bit slots (lo first, then hi) — mirrors SVM.
   148	static inline u64 scatter_bits_2(u64 val, u32 b1, u32 b2) {
   149	    u32 lo = b1 < b2 ? b1 : b2;
   150	    u32 hi = b1 < b2 ? b2 : b1;
   151	    val = insert_zero_bit(val, lo);
   152	    return insert_zero_bit(val, hi);
   153	}
   154	
   155	// Cooperative diagonal phase on an active axis: v[idx | axis_bit] *= phase,
   156	// strided over the 2^(active_k-1) lower half. Matches SVM coop_apply_phase.
   157	static inline void coop_apply_phase(u32 t, CV2Complex* v, u32 axis, CV2Complex phase) {
   158	    u64 axis_bit = 1ull << axis;
   159	    u64 iters = 1ull << (lds_active_k - 1u);
   160	    for (u64 i = t; i < iters; i += 256u) {
   161	        u64 idx = insert_zero_bit(i, axis) | axis_bit;
   162	        v[idx] = cmul(v[idx], phase);
   163	    }
   164	    barrier();
   165	}
   166	
   167	// Wavefront butterfly shuffle of an f64 (lane l receives lane (l^offset)'s
   168	// value) via ds_bpermute — the amdgcn primitive HIP's __shfl_xor lowers to.
   169	static inline double shfl_xor_f64(double v, u32 lane, int offset) {
   170	    u64 bits;
   171	    __builtin_memcpy(&bits, &v, 8);
   172	    u32 lo = (u32)bits, hi = (u32)(bits >> 32);
   173	    u32 addr = ((lane ^ (u32)offset) & 63u) << 2;  // ds_bpermute addr = lane*4
   174	    u32 rlo = __builtin_amdgcn_ds_bpermute((int)addr, (int)lo);
   175	    u32 rhi = __builtin_amdgcn_ds_bpermute((int)addr, (int)hi);
   176	    u64 rbits = ((u64)rhi << 32) | (u64)rlo;
   177	    double r;
   178	    __builtin_memcpy(&r, &rbits, 8);
   179	    return r;
   180	}
   181	
   182	// Cooperative reduction of two per-thread f64 partials across 256 threads.
   183	// MUST reproduce SVM coop_reduce2's exact summation order (intra-wave butterfly
   184	// 32..1, then a 4-warp butterfly 2..1) or f64 rounding diverges at measurement
   185	// branch points on reduction-heavy circuits (rank-10 QEC). All 256 threads call
   186	// it; result broadcast via lds_red[0].
   187	static inline void coop_reduce2(u32 t, double l0, double l1, double* out0, double* out1) {
   188	    u32 lane = t & 63u;
   189	    u32 warp = t >> 6;
   190	    for (int off = 32; off > 0; off >>= 1) {
   191	        l0 += shfl_xor_f64(l0, lane, off);
   192	        l1 += shfl_xor_f64(l1, lane, off);
   193	    }
   194	    if (lane == 0u) { lds_red0[warp] = l0; lds_red1[warp] = l1; }
   195	    barrier();
   196	    if (t < 4u) {
   197	        l0 = lds_red0[t]; l1 = lds_red1[t];
   198	        for (int off = 2; off > 0; off >>= 1) {
   199	            l0 += shfl_xor_f64(l0, lane, off);
   200	            l1 += shfl_xor_f64(l1, lane, off);
   201	        }
   202	    }
   203	    if (t == 0u) { lds_red0[0] = l0; lds_red1[0] = l1; }
   204	    barrier();
   205	    *out0 = lds_red0[0]; *out1 = lds_red1[0];
   206	    barrier();
   207	}
