   236	// tid0-only: apply the Pauli channel drawn at noise site `site_idx` into the
   237	// frame (matches SVM coop OP_NOISE body).
   238	static inline void apply_noise_site(const CV2NoiseSite* sites, const CV2Channel* channels,
   239	                                    u32 site_idx) {
   240	    CV2NoiseSite site = sites[site_idx];
   241	    double roll = rng_uniform(lds_rng) * site.prob_sum;
   242	    double cumulative = 0.0;
   243	    for (u32 k = 0; k < site.count; ++k) {
   244	        const CV2Channel* ch = &channels[site.offset + k];
   245	        cumulative += ch->prob;
   246	        if (roll < cumulative) {
   247	            for (u32 w = 0; w < CLIFFT_V2_PAULI_WORDS; ++w) {
   248	                lds_px[w] ^= ch->x[w];
   249	                lds_pz[w] ^= ch->z[w];
   250	            }
   251	            break;
   252	        }
   253	    }
   254	}
