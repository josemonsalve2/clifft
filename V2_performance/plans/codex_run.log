    65	// ----- RNG (xoshiro256++ seeded by splitmix64), byte-exact with SVM ----------
    66	static inline u64 rotl64(u64 x, int k) { return (x << k) | (x >> (64 - k)); }
    67	static inline u64 splitmix64(u64* state) {
    68	    u64 z = (*state += 0x9e3779b97f4a7c15UL);
    69	    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9UL;
    70	    z = (z ^ (z >> 27)) * 0x94d049bb133111ebUL;
    71	    return z ^ (z >> 31);
    72	}
    73	// rng state lives in LDS (tid0 only draws); s points at lds_rng.
    74	static inline void rng_seed(__attribute__((address_space(3))) u64* s, u64 seed, u64 shot_id) {
    75	    u64 z = seed ^ (0x9e3779b97f4a7c15UL * (shot_id + 1));
    76	    s[0] = splitmix64(&z); s[1] = splitmix64(&z);
    77	    s[2] = splitmix64(&z); s[3] = splitmix64(&z);
    78	}
    79	static inline u64 rng_next(__attribute__((address_space(3))) u64* s) {
    80	    u64 result = rotl64(s[0] + s[3], 23) + s[0];
    81	    u64 t = s[1] << 17;
    82	    s[2] ^= s[0]; s[3] ^= s[1]; s[1] ^= s[2]; s[0] ^= s[3];
    83	    s[2] ^= t;    s[3] = rotl64(s[3], 45);
    84	    return result;
    85	}
    86	static inline double rng_uniform(__attribute__((address_space(3))) u64* s) {
    87	    return (double)(rng_next(s) >> 11) * 0x1.0p-53;
    88	}
    89	
    90	// ----- Pauli-frame bit helpers (on LDS words) --------------------------------
    91	static inline int fget(__attribute__((address_space(3))) u64* w, u32 i) {
    92	    return (int)((w[i >> 6] >> (i & 63u)) & 1UL);
    93	}
    94	static inline void fset(__attribute__((address_space(3))) u64* w, u32 i, int v) {
    95	    u64 m = 1UL << (i & 63u);
    96	    if (v) w[i >> 6] |= m; else w[i >> 6] &= ~m;
    97	}
    98	static inline void fxor(__attribute__((address_space(3))) u64* w, u32 i, int v) {
    99	    if (v) w[i >> 6] ^= 1UL << (i & 63u);
   100	}
   101	static inline void fswap(__attribute__((address_space(3))) u64* w, u32 a, u32 b) {
   102	    int va = fget(w, a), vb = fget(w, b);
   103	    fset(w, a, vb); fset(w, b, va);
   104	}
