   256	// =============================================================================
   257	// execute_shot — the SHARED interpreter body. One workgroup = one shot; 256
   258	// threads cooperate on the amplitude buffer `v` (flat pointer: LDS for the coop
   259	// tier, HBM for the global tier). `scratch` is a half-size fold buffer in the
   260	// same space. `amp_capacity` is the number of amplitudes to zero at init
   261	// (1<<peak_rank). Classical state (frame, meas, obs, rng) always lives in LDS.
   262	// Both kernels below call this; the opcode logic is written ONCE.
   263	// =============================================================================
   264	static void execute_shot(CV2Complex* v, CV2Complex* scratch, u32 amp_capacity,
   265	                         u64 shot_id,
   266	                         const CV2Instr* instrs, u32 num_instrs,
   267	                         u32 total_meas_slots, u32 num_observables,
   268	                         u64 seed,
   269	                         CV2BlockCounts* block_counts,
   270	                         const CV2FusedU2Entry* fused_u2,
   271	                         const CV2FusedU4Entry* fused_u4,
   272	                         const u32* observable_offsets,
   273	                         const u32* observable_targets,
   274	                         const CV2NoiseSite* noise_sites,
   275	                         const CV2Channel* noise_channels,
   276	                         const double* noise_hazards,
   277	                         u32 num_noise_sites,
   278	                         const CV2Mask* pauli_masks,
   279	                         const CV2ReadoutNoise* readout_noise,
   280	                         const u32* detector_offsets,
   281	                         const u32* detector_targets) {
   282	    u32 t = tid();
   283	
   284	    // --- cooperative init ---
   285	    for (u32 i = t; i < amp_capacity; i += 256u) { v[i].re = 0.0f; v[i].im = 0.0f; }
   286	    barrier();
   287	    if (t == 0) {
   288	        for (u32 w = 0; w < CLIFFT_V2_PAULI_WORDS; ++w) { lds_px[w] = 0; lds_pz[w] = 0; }
   289	        lds_active_k = 0;
   290	        lds_discarded = 0;
   291	        v[0].re = 1.0f; v[0].im = 0.0f;
   292	        for (u32 i = 0; i < num_observables; ++i) lds_obs[i] = 0;
   293	        for (u32 i = 0; i < total_meas_slots && i < V2_MAX_MEAS; ++i) lds_meas[i] = 0;
   294	        lds_next_noise = 0;
   295	        rng_seed(lds_rng, seed, shot_id);
   296	        draw_next_noise(noise_hazards, num_noise_sites);
   297	    }
   298	    barrier();
   299	
   300	    // --- interpreter loop (runtime, never unrolled) ---
   301	    for (u32 pc = 0; pc < num_instrs; ++pc) {
   302	        CV2Instr ins = instrs[pc];
   303	        switch (ins.opcode) {
   304	        case OP_FRAME_CNOT:
   305	            if (t == 0) {
   306	                int px_c = fget(lds_px, ins.axis_1);
   307	                int pz_tt = fget(lds_pz, ins.axis_2);
   308	                fxor(lds_px, ins.axis_2, px_c);
   309	                fxor(lds_pz, ins.axis_1, pz_tt);
   310	            }
   311	            barrier();
   312	            break;
   313	        case OP_FRAME_CZ:
   314	            if (t == 0) {
   315	                int px_a = fget(lds_px, ins.axis_1);
   316	                int px_b = fget(lds_px, ins.axis_2);
   317	                fxor(lds_pz, ins.axis_2, px_a);
   318	                fxor(lds_pz, ins.axis_1, px_b);
   319	            }
   320	            barrier();
   321	            break;
   322	        case OP_FRAME_H:
   323	            if (t == 0) {
   324	                int px = fget(lds_px, ins.axis_1);
   325	                int pz = fget(lds_pz, ins.axis_1);
   326	                fset(lds_px, ins.axis_1, pz);
   327	                fset(lds_pz, ins.axis_1, px);
   328	            }
   329	            barrier();
   330	            break;
   331	        case OP_FRAME_S:
   332	        case OP_FRAME_S_DAG:
   333	            if (t == 0) { int px = fget(lds_px, ins.axis_1); fxor(lds_pz, ins.axis_1, px); }
   334	            barrier();
   335	            break;
   336	        case OP_FRAME_SWAP:
   337	            if (t == 0) {
   338	                int px_a = fget(lds_px, ins.axis_1), px_b = fget(lds_px, ins.axis_2);
   339	                fset(lds_px, ins.axis_1, px_b); fset(lds_px, ins.axis_2, px_a);
   340	                int pz_a = fget(lds_pz, ins.axis_1), pz_b = fget(lds_pz, ins.axis_2);
   341	                fset(lds_pz, ins.axis_1, pz_b); fset(lds_pz, ins.axis_2, pz_a);
   342	            }
   343	            barrier();
   344	            break;
   345	        case OP_MEAS_DORMANT_STATIC:
   346	            // outcome from px[axis] (deterministic); tid0-only. flags: identity/sign.
   347	            if (t == 0) {
   348	                u8 mval;
   349	                if (ins.flags & FLAG_IDENTITY) {
   350	                    mval = (ins.flags & FLAG_SIGN) ? 1u : 0u;
   351	                } else {
   352	                    u8 outcome = (u8)fget(lds_px, ins.axis_1);
   353	                    mval = outcome ^ (u8)((ins.flags & FLAG_SIGN) != 0);
   354	                }
   355	                if (ins.a < V2_MAX_MEAS) lds_meas[ins.a] = mval;
   356	            }
   357	            barrier();
   358	            break;
   359	        case OP_MEAS_DORMANT_RANDOM:
   360	            // Random outcome (qubit in superposition, dormant). tid0 draws RNG.
   361	            // Mirrors SVM meas_dormant_random.
   362	            if (t == 0) {
   363	                u8 m_abs = (rng_uniform(lds_rng) < 0.5) ? 0u : 1u;
   364	                fset(lds_px, ins.axis_1, m_abs != 0);
   365	                fset(lds_pz, ins.axis_1, 0);
   366	                if (ins.a < V2_MAX_MEAS)
   367	                    lds_meas[ins.a] = m_abs ^ (u8)((ins.flags & FLAG_SIGN) != 0);
   368	            }
   369	            barrier();
   370	            break;
   371	        case OP_EXPAND: {
   372	            // Virtual H on a dormant axis: duplicate v[0,half) -> v[half,2half).
   373	            u32 half = 1u << lds_active_k;
   374	            for (u32 i = t; i < half; i += 256u) v[i + half] = v[i];
   375	            barrier();
   376	            if (t == 0) lds_active_k += 1;
   377	            barrier();
   378	            break;
