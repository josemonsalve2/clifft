   812	// =============================================================================
   813	// COOP tier kernel (rank <= 10). One workgroup per shot; amplitudes in LDS.
   814	// =============================================================================
   815	__attribute__((amdgpu_kernel, visibility("default")))
   816	void clifft_v2_coop(const CV2Instr* instrs, u32 num_instrs, u32 peak_rank,
   817	                    u32 total_meas_slots, u32 num_observables,
   818	                    u64 seed, u64 shot_offset, u64 shots,
   819	                    CV2BlockCounts* block_counts,
   820	                    const CV2FusedU2Entry* fused_u2,
   821	                    const CV2FusedU4Entry* fused_u4,
   822	                    const u32* observable_offsets,
   823	                    const u32* observable_targets,
   824	                    const CV2NoiseSite* noise_sites,
   825	                    const CV2Channel* noise_channels,
   826	                    const double* noise_hazards,
   827	                    u32 num_noise_sites,
   828	                    const CV2Mask* pauli_masks,
   829	                    const CV2ReadoutNoise* readout_noise,
   830	                    const u32* detector_offsets,
   831	                    const u32* detector_targets) {
   832	    (void)peak_rank;
