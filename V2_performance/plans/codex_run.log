   838	                 seed, block_counts, fused_u2, fused_u4,
   839	                 observable_offsets, observable_targets,
   840	                 noise_sites, noise_channels, noise_hazards, num_noise_sites,
   841	                 pauli_masks, readout_noise, detector_offsets, detector_targets);
   842	}
   843	
   844	// =============================================================================
   845	// GLOBAL tier kernel (rank 11-19). Amplitudes in HBM (one slice per workgroup);
   846	// XCD-aware work-stealing so a fixed grid drains all shots. Interpreter body is
   847	// identical (execute_shot). global_v/global_scratch are sized peak-rank amps.
   848	// =============================================================================
   849	#define V2_NUM_XCDS 8u
   850	__attribute__((amdgpu_kernel, visibility("default")))
   851	void clifft_v2_global(const CV2Instr* instrs, u32 num_instrs, u32 peak_rank,
   852	                      u32 total_meas_slots, u32 num_observables,
   853	                      u64 seed, u64 shot_offset, u64 shots,
   854	                      CV2BlockCounts* block_counts,
   855	                      const CV2FusedU2Entry* fused_u2,
   856	                      const CV2FusedU4Entry* fused_u4,
   857	                      const u32* observable_offsets,
   858	                      const u32* observable_targets,
   859	                      const CV2NoiseSite* noise_sites,
   860	                      const CV2Channel* noise_channels,
   861	                      const double* noise_hazards,
   862	                      u32 num_noise_sites,
   863	                      const CV2Mask* pauli_masks,
   864	                      const CV2ReadoutNoise* readout_noise,
   865	                      const u32* detector_offsets,
   866	                      const u32* detector_targets,
   867	                      CV2Complex* global_v,
   868	                      CV2Complex* global_scratch,
   869	                      u64* work_counter) {
   870	    u32 t = tid();
   871	    u32 slot = bid();
   872	    u64 amp_capacity = 1ull << peak_rank;
   873	    CV2Complex* v = global_v + (u64)slot * amp_capacity;
   874	    CV2Complex* scratch = global_scratch + (u64)slot * (amp_capacity >> 1);
   875	
   876	    // Correctness-first work queue: a SINGLE global atomic counter hands out
   877	    // shot ids. Every shot is processed exactly once regardless of XCD topology.
   878	    // (The per-XCD interleaved variant is a P2 perf optimization; it requires
   879	    // all XCDs be populated to cover the shot space and is topology-fragile.)
   880	    (void)V2_NUM_XCDS; (void)lds_xcd;
   881	    for (;;) {
   882	        if (t == 0) {
   883	            lds_shot = __atomic_fetch_add(&work_counter[0], 1UL, __ATOMIC_RELAXED);
   884	        }
   885	        barrier();
   886	        u64 batch_shot = lds_shot;
   887	        if (batch_shot >= shots) return;
   888	        execute_shot(v, scratch, (u32)amp_capacity,
   889	                     shot_offset + batch_shot, instrs, num_instrs,
   890	                     total_meas_slots, num_observables, seed, block_counts,
   891	                     fused_u2, fused_u4, observable_offsets, observable_targets,
   892	                     noise_sites, noise_channels, noise_hazards, num_noise_sites,
   893	                     pauli_masks, readout_noise, detector_offsets, detector_targets);
   894	        barrier();
   895	    }
   896	}

