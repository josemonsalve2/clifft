   183	
   184	ProbeResult run_probe_detailed(uint32_t n, std::string hsaco_path) {
   185	    ProbeResult r;
   186	    if (hsaco_path.empty()) hsaco_path = CLIFFT_V2_PROBE_HSACO;
   187	    if (hsaco_path.empty()) {
   188	        r.error = "no probe .hsaco path (build with CLIFFT_ENABLE_MLIR_V2)";
   189	        return r;
   190	    }
   191	
   192	    auto& rt = hsa_runtime();
   193	    if (!rt.init()) { r.error = "HSA init failed"; return r; }
   194	
   195	    HsaLoadedKernel kernel;
   196	    try {
   197	        kernel = hsa_load_kernel(hsaco_path, "clifft_v2_probe", 0);
   198	    } catch (const std::exception& e) {
   199	        r.error = std::string("load failed: ") + e.what();
   200	        return r;
   201	    }
   202	    if (!kernel.valid) { r.error = "kernel not valid after load"; return r; }
   203	
   204	    // Device output buffer.
   205	    uint32_t* d_out = static_cast<uint32_t*>(rt.device_malloc(sizeof(uint32_t) * n));
   206	    if (!d_out) { r.error = "device_malloc failed"; hsa_free_kernel(kernel); return r; }
   207	
   208	    // Pack kernel args: {u32* out; u32 n;} — natural layout for amdgpu_kernel.
   209	    struct __attribute__((packed)) { uint64_t out; uint32_t n; } kargs;
   210	    kargs.out = reinterpret_cast<uint64_t>(d_out);
   211	    kargs.n = n;
   212	
   213	    const uint32_t block = 256;
   214	    const uint32_t grid = ((n + block - 1) / block) * block;
   215	    try {
   216	        r.kernel_seconds = hsa_dispatch_and_wait(kernel, 0, grid, block, &kargs, sizeof(kargs));
   217	    } catch (const std::exception& e) {
   218	        r.error = std::string("dispatch failed: ") + e.what();
   219	        rt.device_free(d_out);
   220	        hsa_free_kernel(kernel);
   221	        return r;
   222	    }
   223	
   224	    r.out.resize(n);
   225	    rt.memcpy_d2h(r.out.data(), d_out, sizeof(uint32_t) * n);
   226	    rt.device_free(d_out);
   227	    hsa_free_kernel(kernel);
   228	
   229	    r.ok = true;
   230	    for (uint32_t i = 0; i < n; ++i) {
   231	        if (r.out[i] != i * 2u) { r.ok = false; r.error = "value mismatch at " + std::to_string(i); break; }
   232	    }
   233	    return r;
   234	}
   235	
   236	bool run_probe(uint32_t n, std::string hsaco_path) {
   237	    return run_probe_detailed(n, std::move(hsaco_path)).ok;
   238	}
