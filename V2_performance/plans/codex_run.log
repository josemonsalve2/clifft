   209	// sample_branch — byte-exact with SVM (dust clamp + rng draw only when needed).
   210	static inline u8 sample_branch(double p0, double p1, double total) {
   211	    double eps = V2_DUST_EPS * total;
   212	    if (p1 <= eps) return 0;
   213	    if (p0 <= eps) return 1;
   214	    return (rng_uniform(lds_rng) * total < p0) ? 0u : 1u;
   215	}
   216	
   217	// ROCm device-library transcendental (linked from ocml.bc). SVM's log() lowers
   218	// to this same symbol, so calling it directly keeps V2 byte-exact.
   219	extern double __ocml_log_f64(double);
   220	static inline double ocml_log_f64(double x) { return __ocml_log_f64(x); }
   221	
   222	// tid0-only: advance lds_next_noise via exponential-hazard sampling (byte-exact
   223	// with SVM coop_draw_next_noise). Binary-searches the cumulative-hazard table.
   224	static inline void draw_next_noise(const double* hazards, u32 num_sites) {
   225	    if (num_sites == 0u || lds_next_noise >= num_sites) { lds_next_noise = 0xffffffffu; return; }
   226	    double current_hazard = (lds_next_noise == 0u) ? 0.0 : hazards[lds_next_noise - 1u];
   227	    double target = current_hazard + (-ocml_log_f64(1.0 - rng_uniform(lds_rng)));
   228	    u32 lo = 0u, hi = num_sites;
   229	    while (lo < hi) {
   230	        u32 mid = lo + ((hi - lo) >> 1);
   231	        if (hazards[mid] <= target) lo = mid + 1u; else hi = mid;
   232	    }
   233	    lds_next_noise = (lo >= num_sites) ? 0xffffffffu : lo;
   234	}
