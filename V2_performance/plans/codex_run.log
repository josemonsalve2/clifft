   106	// ----- complex + amplitude helpers -------------------------------------------
   107	#define V2_INV_SQRT2 0.70710678118654752440
   108	#define V2_DUST_EPS  1e-18
   109	
   110	static inline CV2Complex cmul(CV2Complex a, CV2Complex b) {
   111	    CV2Complex r;
   112	    r.re = a.re * b.re - a.im * b.im;
   113	    r.im = a.re * b.im + a.im * b.re;
   114	    return r;
   115	}
   116	static inline CV2Complex cadd(CV2Complex a, CV2Complex b) {
   117	    CV2Complex r; r.re = a.re + b.re; r.im = a.im + b.im; return r;
   118	}
   119	static inline CV2Complex csub(CV2Complex a, CV2Complex b) {
   120	    CV2Complex r; r.re = a.re - b.re; r.im = a.im - b.im; return r;
   121	}
   122	// NOTE: scalar multiply happens in f64 then narrows to f32 — byte-exact with
   123	// SVM cscale (static_cast<float>(static_cast<double>(a.re) * s)). Do NOT
   124	// simplify to an f32 multiply; that desyncs measurement branches vs the gold.
   125	static inline CV2Complex cscale(CV2Complex a, double s) {
   126	    CV2Complex r;
   127	    r.re = (float)((double)a.re * s);
   128	    r.im = (float)((double)a.im * s);
   129	    return r;
   130	}
   131	// |v|^2 accumulated in f64 (match gold cnorm: extend each component first).
   132	static inline double cnorm(CV2Complex v) {
   133	    double re = (double)v.re, im = (double)v.im;
   134	    return re * re + im * im;
   135	}
